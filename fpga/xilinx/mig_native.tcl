create_ip -name mig_7series -vendor xilinx.com -library ip -version 4.2 -module_name mig_native
set mig_native_dir [get_property IP_DIR [get_ips mig_native]]
write_mig_native_prj "${mig_native_dir}/mig_a.prj"
set_property -dict [list \
    CONFIG.XML_INPUT_FILE {mig_a.prj} \
    CONFIG.RESET_BOARD_INTERFACE {Custom} \
    CONFIG.MIG_DONT_TOUCH_PARAM {Custom} \
    CONFIG.BOARD_MIG_PARAM {Custom} \
] [get_ips mig_native]
# Synthesize with the rest of the design like the block design IP.
set_property generate_synth_checkpoint false [get_files mig_native.xci]
generate_target all [get_ips mig_native]
