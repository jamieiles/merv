# Convert a little-endian binary into one 32-bit hex word per line.
file(READ ${IN} hex HEX)
string(LENGTH "${hex}" len)
set(out "")
set(i 0)
while(i LESS len)
    string(SUBSTRING "${hex}" ${i} 8 word)
    string(LENGTH "${word}" wlen)
    while(wlen LESS 8)
        string(APPEND word "0")
        math(EXPR wlen "${wlen} + 1")
    endwhile()
    string(SUBSTRING "${word}" 6 2 b3)
    string(SUBSTRING "${word}" 4 2 b2)
    string(SUBSTRING "${word}" 2 2 b1)
    string(SUBSTRING "${word}" 0 2 b0)
    string(APPEND out "${b3}${b2}${b1}${b0}\n")
    math(EXPR i "${i} + 8")
endwhile()
file(WRITE ${OUT} "${out}")
